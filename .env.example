# ContexOS — modelo de variáveis de ambiente
#
# Copie pra .env (`cp .env.example .env`) e preencha só o que for usar.
# O .env é ignorado pelo git. Nunca cole chave em outro arquivo.

# O fluxo normal de conteúdo NÃO precisa de chave nenhuma. As skills geram
# as imagens e a legenda, e você publica onde e quando quiser.
# Preencha só se for usar um dos recursos opcionais abaixo.

# --- Opcional: foto gerada por IA no /carrossel ---
# Basta UMA das duas. O script detecta sozinho qual você configurou.
# Passo a passo: contexos/templates/imagem-ia.md
#
# Atenção: assinar ChatGPT Plus ou Gemini Advanced NÃO libera isso — acesso por
# aplicativo e acesso por chave (API) são cobrados separado.

# Google Gemini — tem cota gratuita, não pede cartão: aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI — pago por imagem, centavos cada: platform.openai.com/api-keys
OPENAI_API_KEY=

# Se configurar os dois, escolha qual usar (padrão: openai)
# IMAGEM_PROVEDOR=gemini

# --- Opcional/avançado: publicação automática via /aprovar-post ---
# Só pra quem ativar a skill opcional de publicação (templates/opcional/aprovar-post/).
# O fluxo padrão do ContexOS não publica sozinho — entrega os arquivos pra você postar.
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
SITE_URL=
